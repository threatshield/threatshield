# Deployment mode: dev | stage | prod
REACT_APP_DEPLOYMENT_TYPE=dev

REACT_APP_API_URL_DEV=http://localhost:5001/api
REACT_APP_API_URL_PROD=https://your-production-host:5001/api

# Google OAuth Client ID (must match GOOGLE_CLIENT_ID in backend .env)
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Jira base URL for SecReview ID links (optional — links are hidden if unset)
# Example: https://your-org.atlassian.net/browse/
REACT_APP_JIRA_BASE_URL=

GENERATE_SOURCEMAP=false
