# ── LLM Provider ─────────────────────────────────────────────────────────────
# Provider selection: BEDROCK or OPENAI
# Model/endpoint/base_url are configured via the Admin Dashboard and stored in settings.json
LLM_METHOD=OPENAI

# Required if LLM_METHOD=OPENAI
OPENAI_API_KEY=your-openai-api-key

# Required if LLM_METHOD=BEDROCK (proxy key for your Bedrock-compatible endpoint)
BEDROCK_API_KEY=your-bedrock-api-key
# BEDROCK_BASE_URL=https://your-bedrock-proxy-url/

# ── Auth ──────────────────────────────────────────────────────────────────────
# Google OAuth 2.0 Client ID
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Secret key for signing Bearer auth tokens — generate a long random string
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=generate-a-long-random-secret-key

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Integrations (all optional) ───────────────────────────────────────────────
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_KEY=your-confluence-api-token

SLACK_API_TOKEN=xoxb-your-slack-bot-token

JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT=your-jira-project-key

GITHUB_TOKEN=your-github-token

# Google Docs service account — path to JSON file or inline JSON string
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json

# ── Frontend / URLs ───────────────────────────────────────────────────────────
# Base URL of the frontend — used in Slack DM feedback links
FRONTEND_URL=http://localhost:3000

# Frontend deployment mode: dev | stage | prod
REACT_APP_DEPLOYMENT_TYPE=dev

REACT_APP_API_URL_DEV=http://localhost:5001/api
REACT_APP_API_URL_STAGE=
REACT_APP_API_URL_PROD=https://your-production-host:5001/api
